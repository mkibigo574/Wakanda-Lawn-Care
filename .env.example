# Copy to .env.local for local dev, and set the same keys in your Vercel project
# (Settings → Environment Variables). None of these are committed (.env* is gitignored).

# --- Resend (email sending) ---
RESEND_API_KEY=
# Optional overrides (defaults live in api/book.js):
# RESEND_FROM="Wakanda Lawn Care <bookings@wakandalawncare.com.au>"
# BOOKING_TO=admin@wakandalawncare.com.au

# --- Cloudflare Turnstile (spam CAPTCHA) ---
# Secret key from the Cloudflare dashboard. The matching SITE key is public and
# goes in book.html (data-sitekey="..."), not here.
TURNSTILE_SECRET_KEY=
